<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base dark fill -->
    <path
        android:pathData="M0,0H108V108H0Z"
        android:fillColor="#0D0D0D"/>

    <!-- Warm radial glow emanating from center -->
    <path
        android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="54">
                <item android:offset="0.0" android:color="#40330008"/>
                <item android:offset="0.45" android:color="#1A1A0006"/>
                <item android:offset="1.0" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle rose bloom behind where the flame will sit -->
    <path
        android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="60"
                android:gradientRadius="32">
                <item android:offset="0.0" android:color="#26E11D48"/>
                <item android:offset="1.0" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
